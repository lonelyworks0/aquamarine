+namespace {
+bool aqDamageTraceEnabled() {
+    static const bool ENABLED = [] {
+        const char* env = std::getenv("AQ_DAMAGE_TRACE");
+        return env && env[0] == '1' && env[1] == '\0';
+    }();
+    return ENABLED;
+}
+
+void aqDamageTraceLine(const char* line) {
+    if (!aqDamageTraceEnabled() || !line)
+        return;
+
+    static FILE* fp = []() -> FILE* {
+        const int fd = ::open("/tmp/aq-damage-trace.log", O_CREAT | O_WRONLY | O_APPEND | O_CLOEXEC, 0600);
+        return fd < 0 ? nullptr : ::fdopen(fd, "a");
+    }();
+    static unsigned lines = 0;
+    if (!fp || lines >= 8000)
+        return;
+
+    timespec ts{};
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    std::fprintf(fp, "%lld.%09ld %s\n", static_cast<long long>(ts.tv_sec), ts.tv_nsec, line);
+    std::fflush(fp);
+    ++lines;
+}
+}
